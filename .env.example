# Server
PORT=3001
# NODE_ENV=production   # when set to exactly "production", localhost reset-password frontends are omitted

# Postgres (shared schema, evolution-types)
POSTGRES_USER=POSTGRES_USER
POSTGRES_PASSWORD=POSTGRES_PASSWORD
POSTGRES_DB=POSTGRES_DB
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379

# JWT / auth
JWT_SECRET=JWT_SECRET
JWT_ISSUER=JWT_ISSUER
JWT_EXPIRES_IN=24h

# Email (Resend)
RESEND_API_KEY=RESEND_API_KEY
RESEND_FROM_EMAIL=RESEND_FROM_

# R2 (Cloudflare, cosmetic ass
R2_ACCESS_KEY_ID=R2_ACCESS_KEY
R2_SECRET_ACCESS_KEY=R2_SECRET
R2_BUCKET=R2_BUCKET
R2_ENDPOINT=https://test-accou
R2_SIGNED_URL_TTL=600

# Season
SEASON=5

# Annulment (only the literal
ANNULMENT_ENABLED=false

# Rewards worker (projects misff by default)
REWARDS_WORKER_ENABLED=false
REWARDS_WORKER_INTERVAL_MS=300
REWARDS_WORKER_LAG_MS=5000
REWARDS_WORKER_BATCH_SIZE=200